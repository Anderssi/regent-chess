# All optional.
# Leela Chess Zero binary. If unset, uses `lc0` on PATH (brew install lc0).
LC0_PATH=
# Network file; unset uses Homebrew's default (42850).
LC0_WEIGHTS=
# Positions per GPU batch; 32 is much faster than Lc0's own default (0) on Apple silicon.
LC0_MINIBATCH_SIZE=32
# Native Stockfish binary. If unset, uses `stockfish` on PATH, else the bundled WASM build via node.
STOCKFISH_PATH=
LC0_MOVETIME_MS=4000
STOCKFISH_MOVETIME_MS=4000
PORT=3000
DB_PATH=data/regent.sqlite
